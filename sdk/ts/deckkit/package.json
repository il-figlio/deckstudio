{
  "name": "@deckstudio/deckkit",
  "version": "0.1.0",
  "description": "Expose your macOS tool to DeckStudio (Stream Deck+): status file + heartbeat, control token, plugin manifest builder and validator.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=18" },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.js" },
    "./schema.json": "./schema/plugin.schema.json"
  },
  "files": ["src", "schema", "README.md"],
  "sideEffects": false,
  "scripts": {
    "test": "node --test",
    "sync-schema": "node scripts/sync-schema.mjs",
    "prepack": "node scripts/sync-schema.mjs"
  },
  "keywords": ["deckstudio", "stream-deck", "macos", "plugin", "status"]
}
